{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "ruby_3_3@latest",
    "nodejs@latest",
    "yarn@latest",
    "postgresql@latest",
    "libxml2@latest",
    "libxslt@latest",
    "openssl@latest",
    "readline@latest",
    "libffi@latest",
    "libyaml@latest",
    "zlib@latest",
    "pkg-config@latest",
    "gnumake@latest",
    "git@latest",
    "rsync@latest"
  ],
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "TMPDIR": "/private/tmp/oawaiver",
    "LD_LIBRARY_PATH": "$PWD/.devbox/nix/profile/default/lib",
    "FONTCONFIG_PATH": "$PWD/.devbox/nix/profile/default/etc/fonts",
    "BUNDLE_PATH": ".bundle",
    "BUNDLE_BIN": ".binstubs",
    "PATH": ".binstubs:bin:$PATH",
    "RAILS_ENV": "development"
  },
  "shell": {
    "init_hook": [
      "ruby -v",
      "node -v || true",
      "yarn -v || true",
      "gem --version",
      "sh -lc 'gem list -i bundler -v 2.5.6 >/dev/null || gem install bundler -v 2.5.6 --no-document'",
      "bundle config set path \"$BUNDLE_PATH\"",
      "bundle config set bin \"$BUNDLE_BIN\""
    ],
    "scripts": {
      "setup": "gem install bundler -v 2.5.6 --no-document && bundle install && if [ -f package.json ]; then yarn install; fi",
      "rails:server": "bundle exec rails server -b 0.0.0.0 -p 3000",
      "vite:dev": "bundle exec rake vite:dev",
      "vite:build": "bundle exec rake vite:build",
      "solr:start": "bundle exec rake sunspot:solr:start",
      "solr:stop": "bundle exec rake sunspot:solr:stop",
      "solr:reindex": "bundle exec rake sunspot:reindex",
      "test": "bundle exec rspec",
      "cap:staging": "bundle exec cap staging deploy",
      "cap:prod": "bundle exec cap production deploy",
      "prettier:check": "yarn run prettier --check . || yarn run format:check",
      "prettier:fix": "yarn run prettier --write . || yarn run format"
    }
  }
}
