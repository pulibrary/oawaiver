{
  "packages": [
    "ruby@3.2.3",
    "nodejs@22.13.1",
    "yarn@1.22.10",
    "libffi@latest",
    "postgresql@16",
    "libpq@latest",
    "pkg-config@latest",
    "gcc@latest",
    "gnumake@latest",
    "openssl@latest",
    "zlib@latest",
    "readline@latest",
    "libyaml@latest",
    "libxml2@latest",
    "libxslt@latest",
    "git@latest"
  ],
  "shell": {
    "init_hook": [
      "export BUNDLE_PATH=vendor/bundle",
      "export BUNDLE_JOBS=4",
      "export BUNDLE_RETRY=3",
      "export FFI_USE_SYSTEM_LIBFFI=1",
      "FFI_PREFIX=\"$(pkg-config --variable=prefix libffi 2>/dev/null || true)\"; if [ -n \"$FFI_PREFIX\" ]; then export CPPFLAGS=\"-I$FFI_PREFIX/include $CPPFLAGS\"; export LDFLAGS=\"-L$FFI_PREFIX/lib $LDFLAGS\"; bundle config set --local build.ffi \"--with-ffi-dir=$FFI_PREFIX\" >/dev/null; fi",
      "# Ensure bundler stays on the 2.3.x line (Gemfile pins ~> 2.3)",
      "if ! bundle -v 2>/dev/null | grep -q '^Bundler version 2\\.3\\.'; then gem install bundler -v '~> 2.3' --no-document; fi",
      "bundle config set --local path \"$BUNDLE_PATH\" >/dev/null",
      "bundle config set --local jobs \"$BUNDLE_JOBS\" >/dev/null",
      "bundle config set --local retry \"$BUNDLE_RETRY\" >/dev/null"
    ],
    "scripts": {
      "setup": [
        "if [ ! -f .devbox/virtenv/postgresql/data/PG_VERSION ]; then initdb -D .devbox/virtenv/postgresql/data; fi",
        "devbox services restart postgresql",
        "echo 'Waiting for PostgreSQL to initialize...'",
        "until pg_isready -h 127.0.0.1 -p 5432; do sleep 1; done",
        "createuser -s oawaiver 2>/dev/null || echo 'Role oawaiver already exists'",
        "bundle install",
        "yarn install --frozen-lockfile --ignore-engines || yarn install --ignore-engines",
        "bin/rails db:prepare"
      ],
      "server": "bundle exec rails server -p ${PORT:-3000}",
      "console": "bundle exec rails console",
      "test": "bundle exec rspec"
    }
  }
}
